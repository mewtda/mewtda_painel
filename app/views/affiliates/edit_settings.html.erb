<% title 'Configurar Afiliados' %>

<%= form_with model: current_client, url: settings_affiliates_path, method: :patch, html: { autocomplete: 'off' } do |form| %>
  <div class="users-form-page">
    <div class="crm-card users-form-page__card">

      <div class="users-form-page__header">
        <div class="users-form-page__header-icon"><i class="fa-solid fa-link"></i></div>
        <div>
          <h2 class="users-form-page__title">Configurar Afiliados</h2>
          <p class="users-form-page__subtitle">Cliente: <%= current_client.name %></p>
        </div>
      </div>

      <% if current_client.errors.any? %>
        <div class="users-form-page__errors">
          <div class="users-form-page__errors-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
          <div>
            <strong>Corrija os erros abaixo:</strong>
            <ul>
              <% current_client.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <div class="users-form-page__body">
        <div class="users-form-page__section">
          <div class="users-form-page__section-header"><i class="fa-solid fa-link"></i> Site principal</div>
          <p class="users-form-page__hint">
            URL principal da loja. Todo link de afiliado gerado vai usar essa URL como base: o afiliado ou você
            só precisa informar o caminho da página (opcional) na hora de gerar o link.
          </p>
          <div class="users-form-page__field">
            <%= form.label :site_url, 'URL do site', class: 'crm-label' %>
            <%= form.url_field :site_url, class: 'crm-input', required: true, placeholder: 'https://sualojaexemplo.com.br' %>
            <span class="users-form-page__hint">Deve começar com http:// ou https://, sem caminho (ex: sem /produtos/...)</span>
          </div>
        </div>
      </div>

      <div class="users-form-page__footer">
        <%= link_to affiliates_path, class: 'crm-btn crm-btn--secondary' do %>
          <i class="fa-solid fa-arrow-left"></i> Voltar
        <% end %>
        <%= form.button class: 'crm-btn crm-btn--primary', data: { disable_with: 'Salvando...' } do %>
          <i class="fa-solid fa-circle-check"></i> Salvar
        <% end %>
      </div>

    </div>
  </div>
<% end %>
