<%# locals: (client:, automation:) %>
<div class="cpform-status-item">
  <span class="cpform-status-item__label">WhatsApp</span>
  <% if client.whatsapp_ready? %>
    <span class="cpform-status-item__value cpform-status-item__value--success">Conectado</span>
  <% else %>
    <span class="cpform-status-item__value cpform-status-item__value--danger">Nenhum número conectado</span>
  <% end %>
</div>
