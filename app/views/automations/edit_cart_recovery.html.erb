<% title 'Recuperação de Carrinho' %>
<% content_for :head do %><%= stylesheet_link_tag 'whatsapp_support', media: 'all' %><% end %>
<%
  brl = ->(value) { number_to_currency(value, unit: 'R$', separator: ',', delimiter: '.', format: '%u %n') }
  status_label = { running: 'Em execução', pending: 'Aguardando início', finished: 'Finalizada', inactive: 'Inativa' }
  numbers_count = @campaign.persisted? ? @campaign.whatsapp_connections.count : 0
  tabs = [
    ['geral', 'Geral', 'fa-sliders'],
    ['mensagens', 'Mensagens', 'fa-comment-dots'],
    ['numeros', 'Números', 'fa-mobile-screen-button', numbers_count],
    ['conversas', 'Conversas', 'fa-comments'],
    ['resultados', 'Resultados', 'fa-chart-line']
  ]
  switch = lambda do |form, attribute, label, description|
    content_tag(:label, class: 'scr-switch') do
      safe_join([
        content_tag(:span, safe_join([content_tag(:strong, label), (content_tag(:span, description) if description)].compact), class: 'scr-switch__text'),
        form.check_box(attribute),
        content_tag(:span, '', class: 'scr-switch__track')
      ])
    end
  end
%>

<div class="scr" data-screen-tabs>
  <div class="scr-header">
    <div>
      <h1>
        <i class="fa-solid fa-cart-shopping" style="color: var(--primary)"></i> Recuperação de carrinho
        <% if @campaign.persisted? %>
          <span class="scr-chip <%= @campaign.status == :running ? 'scr-chip--on' : '' %>"><%= status_label[@campaign.status] %></span>
        <% end %>
        <% if @campaign.test_phone.present? %>
          <span class="scr-chip scr-chip--warn"><i class="fa-solid fa-flask"></i> Modo teste</span>
        <% end %>
      </h1>
      <p>Mensagens de WhatsApp para quem abandonou o checkout de <%= @client.name %></p>
    </div>
    <div class="scr-header__actions">
      <%= link_to cart_recovery_data_automation_path, class: 'crm-btn crm-btn--secondary' do %>
        <i class="fa-solid fa-table-list"></i> Checkouts abandonados
      <% end %>
      <%= link_to automations_path, class: 'crm-btn crm-btn--secondary' do %>
        <i class="fa-solid fa-arrow-left"></i> Automações
      <% end %>
    </div>
  </div>

  <% unless @client.whatsapp_ready? %>
    <div class="scr-banner scr-banner--danger">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <div><strong>Nenhum número de WhatsApp conectado.</strong>
        <p>Esta automação não envia nada até um número estar conectado e importado em <a href="#numeros" data-tab-link="numeros">Números</a>.</p></div>
    </div>
  <% end %>

  <% if @campaign.errors.any? %>
    <div class="scr-banner scr-banner--danger">
      <i class="fa-solid fa-circle-exclamation"></i>
      <div><strong>Corrija os erros abaixo:</strong>
        <p><%= @campaign.errors.full_messages.to_sentence %></p></div>
    </div>
  <% end %>

  <nav class="scr-tabs" role="tablist" aria-label="Seções da automação">
    <% tabs.each do |key, label, icon, count| %>
      <button type="button" class="scr-tab" role="tab" data-tab="<%= key %>" aria-selected="false">
        <i class="fa-solid <%= icon %>"></i><span><%= label %></span>
        <% if count.to_i.positive? %><span class="scr-tab__count"><%= count %></span><% end %>
      </button>
    <% end %>
  </nav>

  <%= form_with model: @campaign, url: cart_recovery_automation_path, method: :patch, html: { autocomplete: 'off' } do |form| %>
    <%= hidden_field_tag :tab, params[:tab], data: { screen_tab_input: true } %>

    <section class="scr-panel" data-panel="geral" hidden>
      <div class="scr-grid">
        <div class="scr-stack">
          <div class="scr-card">
            <h2 class="scr-card__title"><i class="fa-solid fa-power-off"></i> Automação</h2>
            <%= switch.call(form, :active, 'Automação ativa', 'Desligada, nenhum checkout recebe mensagem.') %>
            <div class="scr-field">
              <%= form.label :name, 'Nome' %>
              <%= form.text_field :name, class: 'crm-input', required: true %>
            </div>
            <div class="scr-row">
              <div class="scr-field">
                <%= form.label :start_date, 'Início' %>
                <%= form.date_field :start_date, class: 'crm-input', required: true %>
              </div>
              <div class="scr-field">
                <%= form.label :end_date, 'Fim' %>
                <%= form.date_field :end_date, class: 'crm-input', required: true %>
              </div>
            </div>
          </div>

          <div class="scr-card <%= 'scr-card--primary' if @campaign.test_phone.present? %>">
            <h2 class="scr-card__title"><i class="fa-solid fa-flask"></i> Modo teste</h2>
            <p class="scr-card__hint">Preenchido, a automação só envia para checkouts com este telefone. Deixe vazio para enviar a todos.</p>
            <div class="scr-field">
              <%= form.label :test_phone, 'Número de teste' %>
              <%= form.text_field :test_phone, class: 'crm-input', placeholder: 'Ex: 16 99199-7608' %>
            </div>
          </div>
        </div>

        <div class="scr-stack">
          <div class="scr-card">
            <h2 class="scr-card__title"><i class="fa-solid fa-circle-info"></i> Situação</h2>
            <dl class="scr-status">
              <div><dt>Status</dt><dd><%= @campaign.persisted? ? status_label[@campaign.status] : 'Ainda não salva' %></dd></div>
              <div><dt>WhatsApp</dt><dd><%= @client.whatsapp_ready? ? 'Conectado' : 'Nenhum número conectado' %></dd></div>
              <div><dt>Números da automação</dt><dd><%= numbers_count %></dd></div>
              <div><dt>Checkouts com telefone</dt><dd><%= @client.abandoned_checkouts.with_phone.count %></dd></div>
              <% if @campaign.persisted? %>
                <div><dt>Criada em</dt><dd><%= @campaign.created_at.strftime('%d/%m/%Y %H:%M') %></dd></div>
              <% end %>
            </dl>
          </div>
          <div class="scr-card">
            <h2 class="scr-card__title"><i class="fa-solid fa-clock-rotate-left"></i> Como funciona</h2>
            <p class="scr-card__hint" style="margin: 0">
              A cada 10 minutos o painel busca os checkouts abandonados na Shopify. Depois do tempo configurado em
              Mensagens, quem deixou o telefone recebe a 1ª mensagem por um dos números da automação, e a 2ª (se ligada)
              sai pelo mesmo número. Só checkouts das últimas 24 horas recebem a 1ª mensagem.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="scr-panel" data-panel="mensagens" hidden>
      <div class="scr-grid">
        <div class="scr-stack">
          <div class="scr-card">
            <h2 class="scr-card__title"><i class="fa-solid fa-1"></i> Primeira mensagem</h2>
            <p class="scr-card__hint">Enviada quando o cliente digita o telefone no checkout e não finaliza a compra.</p>
            <div class="scr-field">
              <%= form.label :send_delay_minutes, 'Enviar após (minutos)' %>
              <%= form.number_field :send_delay_minutes, class: 'crm-input', min: 1, max: 1440, placeholder: 'Ex: 60' %>
              <small>Tempo desde o checkout até a mensagem.</small>
            </div>
            <div class="scr-field">
              <%= form.label :message, 'Texto' %>
              <%= form.text_area :message, class: 'crm-input', rows: 6, required: true %>
              <div class="scr-vars">Variáveis: <code>{nome}</code> <code>{cupom}</code> <code>{link}</code></div>
            </div>
            <%= switch.call(form, :include_coupon, 'Incluir cupom', 'O cupom precisa já existir na Shopify.') %>
            <div class="scr-field">
              <%= form.label :coupon_code, 'Código do cupom' %>
              <%= form.text_field :coupon_code, class: 'crm-input', placeholder: 'Ex: VOLTA10' %>
            </div>
          </div>

          <div class="scr-card">
            <h2 class="scr-card__title"><i class="fa-solid fa-2"></i> Segunda mensagem</h2>
            <p class="scr-card__hint">Se o cliente ainda não comprou, uma segunda mensagem pelo mesmo número da primeira.</p>
            <%= switch.call(form, :resend_enabled, 'Enviar segunda mensagem', nil) %>
            <div class="scr-field">
              <%= form.label :resend_delay_hours, 'Enviar após a 1ª (horas)' %>
              <%= form.number_field :resend_delay_hours, class: 'crm-input', min: 1, max: 168, placeholder: 'Ex: 24' %>
            </div>
            <div class="scr-field">
              <%= form.label :resend_message, 'Texto' %>
              <%= form.text_area :resend_message, class: 'crm-input', rows: 6, placeholder: 'Use as mesmas variáveis: {nome}, {cupom}, {link}' %>
            </div>
            <%= switch.call(form, :resend_include_coupon, 'Incluir cupom', nil) %>
            <div class="scr-field">
              <%= form.label :resend_coupon_code, 'Código do cupom' %>
              <%= form.text_field :resend_coupon_code, class: 'crm-input', placeholder: 'Ex: VOLTA15' %>
            </div>
          </div>
        </div>

        <div class="scr-stack" style="position: sticky; top: 16px;">
          <%= render 'automations/whatsapp_preview' %>
        </div>
      </div>
    </section>

    <div class="scr-sticky" data-screen-save>
      <%= form.button class: 'crm-btn crm-btn--primary', data: { disable_with: 'Salvando...' } do %>
        <i class="fa-solid fa-floppy-disk"></i> Salvar automação
      <% end %>
    </div>
  <% end %>

  <section class="scr-panel" data-panel="numeros" hidden>
    <div class="scr-card">
      <%= render 'automations/whatsapp_numbers', campaign: @campaign, client: @client, kind: 'cart-recovery' %>
    </div>
  </section>

  <section class="scr-panel" data-panel="conversas" id="conversas" hidden>
    <% if @conversation_connections %>
      <%= render 'whatsapp/conversations/inbox', connections: @conversation_connections, campaign: @campaign,
                                                client: @client, empty_state: false, empty_message: nil,
                                                show_header: false %>
    <% else %>
      <div class="scr-card"><p class="scr-card__hint" style="margin: 0">Importe um número em Números para ver as conversas desta automação aqui.</p></div>
    <% end %>
  </section>

  <section class="scr-panel" data-panel="resultados" hidden>
    <div class="scr-header">
      <h2 class="scr-card__title"><i class="fa-solid fa-chart-line"></i> Checkouts abandonados</h2>
      <div class="scr-header__actions">
        <% [7, 30, 90].each do |days| %>
          <%= link_to "#{days} dias", edit_cart_recovery_automation_path(period: days, tab: 'resultados'),
                      class: "crm-btn #{days == @period ? 'crm-btn--primary' : 'crm-btn--secondary'}" %>
        <% end %>
      </div>
    </div>
    <div class="scr-kpis">
      <div class="scr-kpi"><span>Ticket médio</span><strong><%= brl.call(@metrics[:average_ticket]) %></strong></div>
      <div class="scr-kpi"><span>Checkouts abandonados</span><strong><%= @metrics[:count] %></strong></div>
      <div class="scr-kpi"><span>Valor abandonado</span><strong><%= brl.call(@metrics[:total]) %></strong></div>
      <div class="scr-kpi"><span>Valor recuperado</span><strong><%= brl.call(@metrics[:recovered_total]) %></strong><span><%= @metrics[:recovered_count] %> checkout(s)</span></div>
    </div>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.querySelector('[data-screen-tabs]');
    var tabs = root.querySelectorAll('.scr-tab');
    var panels = root.querySelectorAll('.scr-panel');
    var save = root.querySelector('[data-screen-save]');
    var input = root.querySelector('[data-screen-tab-input]');
    var formTabs = ['geral', 'mensagens'];
    var show = function (key) {
      if (!root.querySelector('.scr-panel[data-panel="' + key + '"]')) key = 'geral';
      tabs.forEach(function (t) {
        var on = t.dataset.tab === key;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach(function (p) { p.hidden = p.dataset.panel !== key; });
      save.hidden = formTabs.indexOf(key) === -1;
      input.value = key;
      history.replaceState(null, '', '#' + key);
    };
    tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tab); }); });
    root.querySelectorAll('[data-tab-link]').forEach(function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); show(a.dataset.tabLink); });
    });
    show((location.hash || '').slice(1) || <%= raw params[:tab].to_s.to_json %>);

    var samples = { '{nome}': 'Maria Silva', '{cupom}': 'VOLTA10', '{link}': 'https://loja.exemplo.com/checkouts/abc123' };
    initWhatsappPreviewMulti([
      { id: 'campaign_message', samples: samples },
      { id: 'campaign_resend_message', samples: samples }
    ]);
  });
</script>
