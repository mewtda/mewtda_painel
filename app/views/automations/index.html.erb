<% title 'Automações' %>

<div class="automations-wrapper">

  <div class="automations-intro">
    <h1 class="automations-intro__title">Automações</h1>
    <p class="automations-intro__text">
      Mensagens de WhatsApp disparadas automaticamente com base no comportamento do cliente — sem precisar
      criar uma campanha manual pra cada situação. Configure uma vez e deixe rodando.
    </p>
  </div>

  <% unless @client.whatsapp_ready? %>
    <div class="campaigns-alert campaigns-alert--danger">
      <div class="campaigns-alert__icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
        </svg>
      </div>
      <div class="campaigns-alert__content">
        <strong>Nenhum número de WhatsApp conectado!</strong>
        <p>As automações não serão executadas enquanto não houver um número conectado.</p>
      </div>
    </div>
  <% end %>

  <div class="automations-grid">
    <div class="automations-card">
      <div class="automations-card__icon">
        <i class="fa-solid fa-truck-fast"></i>
      </div>
      <div class="automations-card__body">
        <div class="automations-card__title">Notificação de Rastreio</div>
        <p class="automations-card__description">
          Envia uma mensagem no WhatsApp assim que o pedido tiver código de rastreio, com reenvios automáticos
          até o limite configurado.
        </p>
        <div class="automations-card__tags">
          <% if @tracking_automation.nil? %>
            <span class="crm-tag crm-tag--neutral">Não configurada</span>
          <% elsif @tracking_automation.active? %>
            <span class="crm-tag crm-tag--success">Ativa</span>
          <% else %>
            <span class="crm-tag crm-tag--danger">Inativa</span>
          <% end %>
          <% if @tracking_automation %>
            <span class="crm-tag crm-tag--info"><%= @tracking_automation.sent_count %> enviadas</span>
          <% end %>
        </div>
      </div>
      <div class="automations-card__cta-row">
        <%= link_to edit_tracking_automation_path, class: 'crm-btn crm-btn--primary automations-card__cta' do %>
          <%= @tracking_automation.nil? ? 'Configurar' : 'Editar' %>
        <% end %>
        <% if @tracking_automation %>
          <%= link_to automation_actions_path(@tracking_automation), class: 'crm-btn crm-btn--secondary automations-card__cta' do %>
            Ver Dados
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="automations-card">
      <div class="automations-card__icon">
        <i class="fa-solid fa-coins"></i>
      </div>
      <div class="automations-card__body">
        <div class="automations-card__title">Cashback</div>
        <p class="automations-card__description">
          Envia um cupom de cashback por WhatsApp alguns dias depois da compra, pra incentivar o cliente a
          voltar e comprar de novo.
        </p>
        <div class="automations-card__tags">
          <% if @cashback_automation.nil? %>
            <span class="crm-tag crm-tag--neutral">Não configurada</span>
          <% elsif @cashback_automation.active? %>
            <span class="crm-tag crm-tag--success">Ativa</span>
          <% else %>
            <span class="crm-tag crm-tag--danger">Inativa</span>
          <% end %>
          <% if @cashback_automation %>
            <span class="crm-tag crm-tag--info"><%= @cashback_automation.sent_count %> enviadas</span>
          <% end %>
        </div>
      </div>
      <div class="automations-card__cta-row">
        <%= link_to edit_cashback_automation_path, class: 'crm-btn crm-btn--primary automations-card__cta' do %>
          <%= @cashback_automation.nil? ? 'Configurar' : 'Editar' %>
        <% end %>
        <% if @cashback_automation %>
          <%= link_to automation_actions_path(@cashback_automation), class: 'crm-btn crm-btn--secondary automations-card__cta' do %>
            Ver Dados
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="automations-card">
      <div class="automations-card__icon">
        <i class="fa-solid fa-cart-shopping"></i>
      </div>
      <div class="automations-card__body">
        <div class="automations-card__title">Recuperação de Carrinho</div>
        <p class="automations-card__description">
          Envia mensagem no WhatsApp pra quem chegou no checkout, digitou o telefone e não finalizou a compra —
          com opção de reenvio e cupom.
        </p>
        <div class="automations-card__tags">
          <% if @cart_recovery_automation.nil? %>
            <span class="crm-tag crm-tag--neutral">Não configurada</span>
          <% elsif @cart_recovery_automation.active? %>
            <span class="crm-tag crm-tag--success">Ativa</span>
          <% else %>
            <span class="crm-tag crm-tag--danger">Inativa</span>
          <% end %>
          <span class="crm-tag crm-tag--info"><%= @client.abandoned_checkouts.with_phone.count %> na fila</span>
        </div>
      </div>
      <div class="automations-card__cta-row">
        <%= link_to edit_cart_recovery_automation_path, class: 'crm-btn crm-btn--primary automations-card__cta' do %>
          <%= @cart_recovery_automation.nil? ? 'Configurar' : 'Editar' %>
        <% end %>
        <%= link_to cart_recovery_data_automation_path, class: 'crm-btn crm-btn--secondary automations-card__cta' do %>
          Ver Dados
        <% end %>
      </div>
    </div>

    <div class="automations-card automations-card--soon">
      <div class="automations-card__icon">
        <i class="fa-solid fa-hourglass-half"></i>
      </div>
      <div class="automations-card__body">
        <div class="automations-card__title">Mais automações em breve</div>
        <p class="automations-card__description">
          Lembrete de expiração de cupom e notificações de marketing estão em desenvolvimento.
        </p>
      </div>
    </div>
  </div>

</div>
