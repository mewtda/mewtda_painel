<% title 'Campanhas' %>

<div class="clients-wrapper cx-page">
  <div class="clients-table-wrap">
    <div class="clients-table-header">
      <span class="clients-table-header__title"><i class="fa-solid fa-bullhorn"></i> Campanhas</span>
      <div class="sg-header-actions">
        <%= form_with url: campaigns_path, method: :get, class: 'ec-filters', data: { live_regions: 'ec-table' } do %>
          <%= select_tag :canal, options_for_select([['Todos os canais', '']] + Campaign::CHANNELS.invert.to_a, params[:canal]),
                         class: 'crm-input cx-select', data: { autosubmit: true, custom_select: true } %>
          <div class="cx-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <%= search_field_tag :q, params[:q], class: 'crm-input', placeholder: 'Buscar campanha',
                                 autofocus: params[:q].present?, data: { autosubmit_typing: true } %>
          </div>
        <% end %>
        <%= link_to campaign_performance_path, class: 'crm-btn crm-btn--secondary' do %>
          <i class="fa-solid fa-chart-column"></i> Desempenho
        <% end %>
        <%= button_to campaigns_path, method: :post, class: 'crm-btn crm-btn--primary' do %>
          <i class="fa-solid fa-plus"></i> Criar campanha
        <% end %>
      </div>
    </div>

    <div id="ec-table" data-live-spinner>
    <% spent = @investment.spent_total %>
    <% forecast = @investment.forecast_total %>
    <% count = ->(value) { number_with_delimiter(value, delimiter: '.') } %>
    <% kpis = [
         ['Total investido', spent.total, "#{count.call(spent.emails)} e-mails · #{count.call(spent.whatsapps)} WhatsApps enviados",
          'Tarifa estimada da Meta mais o custo de envio no painel, somando as mensagens já enviadas das campanhas listadas.', true],
         ['Tarifa da Meta (estimada)', spent.meta, 'Cobrada no cartão da conta do WhatsApp',
          "Cerca de #{campaign_cost_label(Campaigns::Performance::META_MARKETING_PRICE)} por WhatsApp de marketing enviado. A Meta cobra só as entregues, direto no cartão da conta do WhatsApp da loja; o valor exato está no Gerenciador do WhatsApp.", false],
         ['Envio pelo painel', spent.panel, 'Entra na fatura do painel', 'R$ 4,00 por mil e-mails e R$ 0,10 por WhatsApp enviados.', false],
         ['Previsão das agendadas', forecast.total, "Meta #{campaign_cost_label(forecast.meta)} · painel #{campaign_cost_label(forecast.panel)}",
          'O que ainda vai sair das campanhas agendadas, enviando ou pausadas, com o público de agora. Pode mudar até o envio.', false]
       ] %>
    <section class="ec-investment" aria-label="Investimento nas campanhas">
      <% kpis.each do |label, value, detail, hint, main| %>
        <div class="ss-kpi <%= 'ss-kpi--main' if main %>">
          <div class="ss-kpi__label"><%= label %> <span class="ec-info" tabindex="0" title="<%= hint %>"><i class="fa-solid fa-circle-info"></i></span></div>
          <div class="ss-kpi__value"><%= campaign_cost_label(value) %></div>
          <span class="ss-kpi__change ss-kpi__change--neutral"><%= detail %></span>
        </div>
      <% end %>
    </section>

    <table class="crm-table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Canal de envio</th>
          <th>Status</th>
          <th>Para quem</th>
          <th>Envio</th>
          <th>Investimento</th>
          <th>Criada por</th>
          <th class="text-center">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @campaigns.each do |campaign| %>
          <tr>
            <td>
              <% if campaign.draft? %>
                <%= link_to campaign.display_name, edit_campaign_path(campaign), class: 'cx-link' %>
              <% else %>
                <%= link_to campaign.display_name, details_campaign_path(campaign), class: 'cx-link', data: { campaign_details: details_campaign_path(campaign) } %>
              <% end %>
              <% names = campaign.messages.filter_map(&:template_name).uniq %>
              <% if names.any? %><small class="cx-muted ec-sub"><%= names.first(2).join(' · ') %><%= " +#{names.size - 2}" if names.size > 2 %></small><% end %>
            </td>
            <td data-label="Canal de envio">
              <span class="ec-channels"><% campaign_channels(campaign).each do |channel| %><%= campaign_channel_tag(channel) %> <% end %></span>
            </td>
            <td data-label="Status"><%= campaign_status_tag(campaign) %></td>
            <td class="cx-muted" data-label="Para quem">
              <% if campaign.segments.any? %>
                <%= safe_join(campaign.segments.map { |segment| link_to segment.name, customers_path(segment_id: segment.id), class: 'cx-link' }, ', ') %>
              <% else %>
                —
              <% end %>
            </td>
            <td class="cx-muted" data-label="Envio">
              <span class="ec-cell">
                <%= campaign.timing_summary %>
                <% if campaign.progress_label %><small class="ec-sub"><%= campaign.progress_label %></small><% end %>
                <% if campaign.status_note %><small class="ec-sub"><%= campaign.status_note %></small><% end %>
              </span>
            </td>
            <td class="cx-nowrap" data-label="Investimento">
              <% row = @investment.for(campaign) %>
              <span class="ec-cell">
                <% if row.spent.zero? && row.forecast.zero? %>
                  <span class="cx-muted">—</span>
                <% end %>
                <% unless row.spent.zero? %>
                  <strong><%= campaign_cost_label(row.spent.total) %></strong>
                  <small class="cx-muted ec-sub">Meta <%= campaign_cost_label(row.spent.meta) %> · painel <%= campaign_cost_label(row.spent.panel) %></small>
                <% end %>
                <% unless row.forecast.zero? %>
                  <span>Previsão <%= campaign_cost_label(row.forecast.total) %></span>
                  <small class="cx-muted ec-sub">Meta <%= campaign_cost_label(row.forecast.meta) %> · painel <%= campaign_cost_label(row.forecast.panel) %></small>
                <% end %>
              </span>
            </td>
            <td class="cx-nowrap" data-label="Criada por">
              <span class="ec-cell">
                <%= campaign.created_by&.name || '—' %>
                <small class="cx-muted ec-sub"><%= l(campaign.created_at, format: '%d/%m/%Y às %H:%M') %></small>
              </span>
            </td>
            <td class="text-center">
              <div class="clients-table__actions">
                <% if campaign.draft? %>
                  <%= link_to edit_campaign_path(campaign), class: 'crm-btn clients-btn--icon', title: 'Continuar editando' do %>
                    <i class="fa-solid fa-pen"></i>
                  <% end %>
                <% end %>
                <% unless campaign.draft? %>
                  <%= link_to details_campaign_path(campaign), class: 'crm-btn clients-btn--icon', title: 'Detalhes da campanha',
                      data: { campaign_details: details_campaign_path(campaign) } do %>
                    <i class="fa-solid fa-eye"></i>
                  <% end %>
                  <% if campaign.started_at %>
                    <%= link_to deliveries_campaign_path(campaign), class: 'crm-btn ec-deliveries-btn', title: 'Quem recebeu e quem não recebeu cada mensagem' do %>
                      <i class="fa-solid fa-users-viewfinder"></i> Detalhar envios
                    <% end %>
                    <%= link_to campaign_performance_path(campanha: campaign.id), class: 'crm-btn clients-btn--icon', title: 'Ver desempenho' do %>
                      <i class="fa-solid fa-chart-column"></i>
                    <% end %>
                  <% end %>
                <% end %>
                <% if campaign.cancelable? %>
                  <%= button_to cancel_campaign_path(campaign), method: :post, class: 'crm-btn clients-btn--icon clients-btn--danger', title: 'Cancelar campanha',
                      form: { data: { confirm: "Cancelar a campanha \"#{campaign.display_name}\"? Quem já recebeu não é afetado e o restante não será enviado.",
                                      confirm_label: 'Cancelar campanha', confirm_cancel_label: 'Voltar' } } do %>
                    <i class="fa-solid fa-ban"></i>
                  <% end %>
                <% end %>
                <% if campaign.status.in?(%w[draft cancelled]) %>
                  <%= button_to campaign_path(campaign), method: :delete, class: 'crm-btn clients-btn--icon clients-btn--danger', title: 'Excluir',
                      form: { data: { confirm: "Excluir a campanha \"#{campaign.display_name}\"?", confirm_label: 'Excluir' } } do %>
                    <i class="fa-solid fa-trash-can"></i>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @campaigns.empty? %>
          <tr>
            <td colspan="8" class="clients-table__empty">
              Você ainda não criou nenhuma campanha. Clique em <strong>Criar campanha</strong> para começar.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
</div>

<dialog class="crm-confirm ec-details" id="ec-details-dialog">
  <div class="ec-details__head">
    <h2 class="crm-confirm__title">Detalhes da campanha</h2>
    <button type="button" class="ec-details__close" data-details-close aria-label="Fechar"><i class="fa-solid fa-xmark"></i></button>
  </div>
  <div class="ec-details__body" data-details-body></div>
</dialog>

<%= javascript_include_tag 'campaign_details', defer: true %>
