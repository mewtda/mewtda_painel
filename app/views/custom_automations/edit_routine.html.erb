<% title @routine[:title] %>

<div class="users-form-page">
  <div class="crm-card users-form-page__card">

    <div class="users-form-page__header">
      <div class="users-form-page__header-icon"><i class="<%= @routine[:icon] %>"></i></div>
      <div>
        <h2 class="users-form-page__title"><%= @routine[:title] %></h2>
        <p class="users-form-page__subtitle">Cliente: <%= @client.name %> · <%= @routine[:frequency] %></p>
      </div>
    </div>

    <% if @setting.errors.any? %>
      <div class="users-form-page__errors">
        <div class="users-form-page__errors-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div>
          <strong>Corrija os erros abaixo:</strong>
          <ul>
            <% @setting.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <%= form_with scope: :routine, url: update_routine_custom_automations_path(kind: @kind), method: :patch,
                  data: { turbo: false }, html: { autocomplete: 'off' } do |form| %>
      <div class="users-form-page__body">

        <div class="users-form-page__section">
          <div class="users-form-page__section-header"><i class="fa-solid fa-users"></i> Quem recebe</div>
          <p class="users-form-page__hint"><%= @routine[:description] %></p>
          <div class="users-form-page__field">
            <%= form.label :recipients, 'E-mails', class: 'crm-label' %>
            <%= form.text_area :recipients, value: @setting.recipients_text, rows: 4, class: 'crm-input',
                               placeholder: "dona@loja.com.br\nfinanceiro@loja.com.br" %>
            <span class="users-form-page__hint">Um e-mail por linha (ou separados por vírgula).</span>
          </div>
        </div>

        <div class="users-form-page__section">
          <div class="users-form-page__section-header"><i class="fa-solid fa-box-open"></i> Estoque baixo</div>
          <p class="users-form-page__hint">
            Entram no e-mail as variantes de produtos ativos com esta quantidade ou menos em estoque.
          </p>
          <div class="users-form-page__field">
            <%= form.label :low_stock_limit, 'Avisar com até (unidades)', class: 'crm-label' %>
            <%= form.number_field :low_stock_limit, value: @setting.low_stock_limit, min: 1, max: 1000,
                                  class: 'crm-input', style: 'max-width: 160px;', required: true %>
          </div>
        </div>

        <div class="users-form-page__section">
          <div class="users-form-page__section-header"><i class="fa-solid fa-clock"></i> Envio automático</div>
          <div class="users-form-page__field">
            <div class="cform-toggle">
              <%= form.check_box :enabled, { checked: @setting.enabled?, class: 'cform-toggle__input' }, '1', '0' %>
              <span class="cform-toggle__label">Enviar automaticamente <%= @routine[:frequency].downcase %></span>
            </div>
          </div>
          <p class="users-form-page__hint">
            <% if @setting.last_run_at %>
              Último envio: <%= l(@setting.last_run_at, format: '%d/%m/%Y %H:%M') %>.
            <% else %>
              Ainda não foi enviado.
            <% end %>
            O e-mail sai de <%= @client.tools_email_domain || 'domínio não configurado' %>.
          </p>
        </div>
      </div>

      <div class="users-form-page__footer">
        <%= link_to custom_automations_path(tab: @kind), class: 'crm-btn crm-btn--secondary' do %>
          <i class="fa-solid fa-arrow-left"></i> Voltar
        <% end %>
        <%= link_to preview_routine_custom_automations_path(kind: @kind), class: 'crm-btn crm-btn--secondary',
                    target: '_blank', rel: 'noopener' do %>
          <i class="fa-solid fa-eye"></i> Ver prévia do e-mail
        <% end %>
        <% if @setting.persisted? && @setting.recipients.any? %>
          <button type="submit" form="routine-run-now" class="crm-btn crm-btn--secondary"
                  title="Manda o resumo da semana passada agora para <%= pluralize(@setting.recipients.size, 'destinatário', plural: 'destinatários') %>">
            <i class="fa-solid fa-paper-plane"></i> Enviar agora
          </button>
        <% end %>
        <%= form.button class: 'crm-btn crm-btn--primary', data: { disable_with: 'Salvando...' } do %>
          <i class="fa-solid fa-circle-check"></i> Salvar
        <% end %>
      </div>
    <% end %>

    <%# Form próprio (fora do de salvar) para o botão "Enviar agora" do rodapé. %>
    <%= form_with url: run_routine_custom_automations_path(kind: @kind), method: :post, id: 'routine-run-now',
                  data: { turbo: false } do %><% end %>

  </div>
</div>
