<%
  money = ->(value) { number_to_currency(value.to_f, unit: 'R$', separator: ',', delimiter: '.', format: '%u %n') }
  change = lambda do |kpi|
    pct = kpi[:change]
    next '<span style="color:#8a8f9c;">sem base na semana anterior</span>'.html_safe if pct.nil?

    color = pct >= 0 ? '#1d7a3e' : '#c5221f'
    arrow = pct >= 0 ? '▲' : '▼'
    "<span style=\"color:#{color};\">#{arrow} #{number_with_precision(pct.abs, precision: 1, separator: ',')}% vs. semana anterior</span>".html_safe
  end
  kpis = report.kpis
  tiles = [
    ['Faturamento', money.call(kpis[:revenue][:value]), change.call(kpis[:revenue])],
    ['Pedidos', number_with_delimiter(kpis[:orders][:value], delimiter: '.'), change.call(kpis[:orders])],
    ['Ticket médio', kpis[:average_ticket][:value] ? money.call(kpis[:average_ticket][:value]) : '—', change.call(kpis[:average_ticket])],
    ['Peças vendidas', number_with_delimiter(report.units, delimiter: '.'), ''.html_safe]
  ]
  low_stock = report.low_stock
  cell = 'padding:10px 12px;border-bottom:1px solid #ececef;font-size:13px;color:#0d1321;'
  head = 'padding:8px 12px;border-bottom:1px solid #d9dbe1;font-size:11px;color:#6f7482;text-transform:uppercase;letter-spacing:.04em;text-align:left;'
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= report.subject %></title>
</head>
<body style="margin:0;padding:0;background:#f6f5fa;font-family:Arial,Helvetica,sans-serif;color:#0d1321;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f5fa;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:680px;background:#ffffff;border-radius:12px;border:1px solid #ececef;">
          <tr>
            <td style="padding:28px 28px 8px;">
              <div style="font-size:12px;color:#5800e8;font-weight:bold;letter-spacing:.06em;text-transform:uppercase;">Resumo da semana</div>
              <h1 style="margin:6px 0 4px;font-size:22px;"><%= report.client.name %></h1>
              <div style="font-size:14px;color:#6f7482;">
                <%= l(report.from, format: '%d/%m/%Y') %> a <%= l(report.to, format: '%d/%m/%Y') %> (segunda a domingo)
              </div>
            </td>
          </tr>

          <tr>
            <td style="padding:16px 22px 4px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <% tiles.each do |label, value, detail| %>
                    <td width="25%" valign="top" style="padding:6px;">
                      <div style="border:1px solid #ececef;border-radius:10px;padding:12px;">
                        <div style="font-size:11px;color:#6f7482;text-transform:uppercase;letter-spacing:.04em;"><%= label %></div>
                        <div style="font-size:19px;font-weight:bold;margin:6px 0 4px;white-space:nowrap;"><%= value %></div>
                        <div style="font-size:11px;"><%= detail %></div>
                      </div>
                    </td>
                  <% end %>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:20px 28px 4px;">
              <h2 style="margin:0 0 4px;font-size:16px;">O que mais vendeu</h2>
              <div style="font-size:13px;color:#6f7482;margin-bottom:10px;">Por faturamento, somando todas as variantes do produto.</div>
              <% if report.top_products.empty? %>
                <div style="font-size:13px;color:#6f7482;padding:12px 0;">Nenhuma venda na semana.</div>
              <% else %>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <th style="<%= head %>">#</th>
                    <th style="<%= head %>">Produto</th>
                    <th style="<%= head %>text-align:right;">Peças</th>
                    <th style="<%= head %>text-align:right;">Faturamento</th>
                  </tr>
                  <% report.top_products.each do |item| %>
                    <tr>
                      <td style="<%= cell %>color:#6f7482;"><%= item.rank %></td>
                      <td style="<%= cell %>">
                        <% if item.image_url.present? %>
                          <img src="<%= item.image_url %>" width="32" height="32" alt="" style="border-radius:6px;vertical-align:middle;margin-right:8px;object-fit:cover;">
                        <% end %>
                        <%= item.name %>
                      </td>
                      <td style="<%= cell %>text-align:right;"><%= item.units %></td>
                      <td style="<%= cell %>text-align:right;white-space:nowrap;"><%= money.call(item.revenue) %></td>
                    </tr>
                  <% end %>
                </table>
              <% end %>
            </td>
          </tr>

          <tr>
            <td style="padding:24px 28px 8px;">
              <h2 style="margin:0 0 4px;font-size:16px;">Estoque baixo no site</h2>
              <div style="font-size:13px;color:#6f7482;margin-bottom:10px;">
                Variantes de produtos ativos com <%= report.low_stock_limit %> unidade<%= 's' if report.low_stock_limit > 1 %> ou menos,
                lidas da Shopify agora. As que venderam na semana aparecem primeiro.
              </div>
              <% if report.low_stock_error %>
                <div style="font-size:13px;color:#b06000;background:#fef7e0;border-radius:8px;padding:10px 12px;">
                  Não foi possível ler o estoque na Shopify: <%= report.low_stock_error %>
                </div>
              <% elsif low_stock.empty? %>
                <div style="font-size:13px;color:#1d7a3e;padding:12px 0;">Nenhuma variante com estoque baixo.</div>
              <% else %>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <th style="<%= head %>">Produto</th>
                    <th style="<%= head %>">SKU</th>
                    <th style="<%= head %>text-align:right;">Vendidas na semana</th>
                    <th style="<%= head %>text-align:right;">Estoque</th>
                  </tr>
                  <% low_stock.first(CustomAutomations::WeeklySalesReport::LOW_STOCK_ROWS).each do |variant| %>
                    <tr>
                      <td style="<%= cell %>">
                        <%= variant.product %>
                        <% if variant.variant %><div style="font-size:12px;color:#6f7482;"><%= variant.variant %></div><% end %>
                      </td>
                      <td style="<%= cell %>color:#6f7482;"><%= variant.sku.presence || '—' %></td>
                      <td style="<%= cell %>text-align:right;"><%= variant.sold.positive? ? variant.sold : '—' %></td>
                      <td style="<%= cell %>text-align:right;font-weight:bold;color:<%= variant.quantity <= 0 ? '#c5221f' : '#b06000' %>;">
                        <%= variant.quantity <= 0 ? 'Esgotado' : variant.quantity %>
                      </td>
                    </tr>
                  <% end %>
                </table>
                <% if low_stock.size > CustomAutomations::WeeklySalesReport::LOW_STOCK_ROWS %>
                  <div style="font-size:12px;color:#6f7482;padding-top:8px;">
                    E mais <%= low_stock.size - CustomAutomations::WeeklySalesReport::LOW_STOCK_ROWS %> variantes com estoque baixo.
                  </div>
                <% end %>
              <% end %>
            </td>
          </tr>

          <tr>
            <td style="padding:20px 28px 28px;font-size:12px;color:#8a8f9c;border-top:1px solid #ececef;">
              Relatório automático do MeuCRM, enviado toda segunda às 8h. Para mudar quem recebe, acesse
              Automações personalizadas no painel.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
