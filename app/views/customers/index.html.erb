<% title 'Clientes' %>
<% brl = ->(v) { number_to_currency(v, unit: 'R$', separator: ',', delimiter: '.', precision: 2) } %>
<% filter_params = params.permit(:q, :segment_id, :sort, :dir, rfm: []).to_h %>
<% sort_link = lambda do |key, label|
     active = @sort == key
     dir = active && @direction == 'DESC' ? 'asc' : 'desc'
     link_to customers_path(filter_params.merge(sort: key, dir: dir)), class: "cx-sort #{'is-active' if active}" do
       safe_join([label, tag.i(class: "fa-solid #{active ? (@direction == 'DESC' ? 'fa-arrow-down' : 'fa-arrow-up') : 'fa-sort'}")], ' ')
     end
   end %>

<div class="clients-wrapper cx-page">
  <%= render 'customers/tabs' %>

  <%# KPIs da base %>
  <div class="cx-kpis">
    <div class="cx-kpi"><span>Clientes compradores</span><strong><%= number_with_delimiter(@summary[:total], delimiter: '.') %></strong></div>
    <div class="cx-kpi"><span>Ativos (RFM)</span><strong><%= number_with_delimiter(@summary[:active], delimiter: '.') %></strong>
      <small><%= @summary[:total].zero? ? 0 : (@summary[:active] * 100.0 / @summary[:total]).round(1) %>% da base</small></div>
    <div class="cx-kpi"><span>Recompra</span><strong><%= number_with_precision(@summary[:repeat_rate], precision: 1, separator: ',') %>%</strong>
      <small>compraram 2+ vezes</small></div>
    <div class="cx-kpi"><span>Ticket médio</span><strong><%= brl.call(@summary[:avg_ticket]) %></strong></div>
    <div class="cx-kpi"><span>LTV médio</span><strong><%= brl.call(@summary[:ltv]) %></strong><small>total gasto por cliente</small></div>
  </div>

  <div class="clients-table-wrap">
    <%# Barra de filtros %>
    <%= form_with url: customers_path, method: :get, class: 'cx-toolbar', id: 'cx-filter-form' do %>
      <div class="cx-toolbar__left">
        <span class="cx-count">
          <strong><%= number_with_delimiter(@filtered_count, delimiter: '.') %></strong> clientes
          <% if @segment %>em <span class="crm-tag crm-tag--warning"><%= @segment.name %></span><% end %>
        </span>
        <%= link_to export_xlsx_customers_path(filter_params.except('sort', 'dir')), class: 'cx-link' do %>
          <i class="fa-solid fa-download"></i> Exportar planilha
        <% end %>
      </div>
      <div class="cx-toolbar__right">
        <%= select_tag :segment_id, options_for_select([['Toda a base', '']] + @segments.map { |s| ["#{s.kind_label}: #{s.name}", s.id] }, params[:segment_id]),
                       class: 'crm-input cx-select', onchange: 'this.form.requestSubmit()' %>
        <div class="cx-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <%= search_field_tag :q, params[:q], class: 'crm-input', placeholder: 'Nome, e-mail ou telefone' %>
        </div>
        <%= hidden_field_tag :sort, params[:sort] %>
        <%= hidden_field_tag :dir, params[:dir] %>
      </div>

      <div class="cx-rfm-chips">
        <span class="cx-rfm-chips__label">Perfil RFM:</span>
        <% CustomerProfile::RFM_SEGMENTS.each do |key, info| %>
          <label class="cx-chip <%= 'is-on' if @rfm_filter.include?(key) %>" style="--rfm: <%= info[:color] %>" title="<%= info[:hint] %>">
            <%= check_box_tag 'rfm[]', key, @rfm_filter.include?(key), onchange: 'this.form.requestSubmit()', id: "rfm-#{key}" %>
            <%= info[:label] %>
          </label>
        <% end %>
        <% if params[:q].present? || params[:segment_id].present? || @rfm_filter.any? %>
          <%= link_to 'Limpar filtros', customers_path, class: 'cx-link cx-link--muted' %>
        <% end %>
      </div>
    <% end %>

    <%# Ação em massa: adicionar à lista %>
    <%= form_with url: add_to_list_customers_path, method: :post, id: 'cx-bulk-form', class: 'cx-bulk', html: { hidden: true } do %>
      <% filter_params.except('sort', 'dir').each do |key, value| %>
        <% Array(value).each do |v| %><%= hidden_field_tag(value.is_a?(Array) ? "#{key}[]" : key, v, id: nil) %><% end %>
      <% end %>
      <%= hidden_field_tag :all_filtered, '0', id: 'cx-all-filtered' %>
      <span id="cx-bulk-count"></span>
      <button type="button" class="cx-link" id="cx-select-all-filtered">Selecionar todos os <%= number_with_delimiter(@filtered_count, delimiter: '.') %> do filtro</button>
      <span class="cx-bulk__spacer"></span>
      <%= select_tag :list_id, options_for_select(@lists.map { |l| [l.name, l.id] }), include_blank: 'Escolha uma lista…', class: 'crm-input cx-select' %>
      <span class="eb-muted">ou</span>
      <%= text_field_tag :new_list_name, nil, class: 'crm-input', placeholder: 'Nova lista' %>
      <button class="crm-btn crm-btn--primary"><i class="fa-solid fa-list-check"></i> Adicionar à lista</button>
    <% end %>

    <div class="cx-table-scroll">
      <table class="crm-table cx-table">
        <thead>
          <tr>
            <th class="cx-check"><input type="checkbox" id="cx-check-all" aria-label="Selecionar todos da página"></th>
            <th><%= sort_link.call('name', 'Nome') %></th>
            <th>Telefone</th>
            <th><%= sort_link.call('last_order_at', 'Última compra') %></th>
            <th class="text-center"><%= sort_link.call('orders_count', 'Nº de compras') %></th>
            <th><%= sort_link.call('avg_ticket', 'Ticket médio') %></th>
            <th><%= sort_link.call('total_spent', 'Total gasto') %></th>
            <th><%= sort_link.call('rfm', 'Perfil RFM') %></th>
            <th>Cidade</th>
            <th>E-mail</th>
            <th class="text-center">Pop-up</th>
          </tr>
        </thead>
        <tbody>
          <% if @profiles.empty? %>
            <tr><td colspan="11" class="customers-table__empty">Nenhum cliente encontrado.</td></tr>
          <% end %>
          <% @profiles.each do |p| %>
            <tr class="cx-row" data-customer-id="<%= p.customer_id %>">
              <td class="cx-check"><input type="checkbox" name="customer_ids[]" value="<%= p.customer_id %>" form="cx-bulk-form" class="cx-row-check" aria-label="Selecionar"></td>
              <td class="cx-name">
                <span class="customers-avatar"><%= p.name.to_s.split.first(2).map { |w| w[0] }.join.upcase.presence || '?' %></span>
                <span><%= p.name.presence || 'Sem nome' %></span>
              </td>
              <td class="cx-nowrap"><%= p.phone.presence || '—' %></td>
              <td class="cx-nowrap">
                <%= p.last_order_at ? l(p.last_order_at.to_date, format: '%d/%m/%Y') : '—' %>
                <% if (days = p.days_since_last_order) %><small class="cx-muted">há <%= days %>d</small><% end %>
              </td>
              <td class="text-center"><span class="customers-badge customers-badge--orders"><%= p.orders_count %></span></td>
              <td class="cx-nowrap"><%= brl.call(p.avg_ticket) %></td>
              <td class="cx-nowrap"><strong><%= brl.call(p.total_spent) %></strong></td>
              <td><%= render 'customers/rfm_tag', segment: p.rfm_segment %></td>
              <td class="cx-nowrap"><%= [p.city, p.state].compact.join(' / ').presence || '—' %></td>
              <td class="cx-email"><%= p.email.presence || '—' %></td>
              <td class="text-center">
                <% if p.email.present? && @popup_emails.include?(p.email) %>
                  <span class="crm-tag crm-tag--success">Cadastrado</span>
                <% else %>
                  <span class="crm-tag crm-tag--neutral">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="cx-footer">
      <span class="cx-muted">
        <i class="fa-solid fa-rotate"></i>
        Base atualizada <%= @refreshed_at ? "há #{time_ago_in_words(@refreshed_at)}" : 'ainda não calculada' %>
      </span>
      <%= button_to refresh_customers_path, class: 'cx-link', form_class: 'cx-inline' do %>Atualizar agora<% end %>
      <span class="cx-bulk__spacer"></span>
      <%= will_paginate @profiles, list_classes: %w[pagination justify-content-center], inner_window: 1, params: filter_params %>
    </div>
  </div>
</div>

<%= render 'customers/detail_drawer' %>
<%= javascript_include_tag 'customers', defer: true %>
