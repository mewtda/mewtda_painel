<%# Relatório do Trackeamento site. Renderizado pelo TrackingReportJob e
    entregue pelo TrackingReportChannel (ver dashboard/index). %>
<% if @empty_state %>
  <div class="db-card">
    <div class="db-empty">
      <h2 class="db-empty__title">Nenhum dado disponivel</h2>
      <p class="db-empty__text"><%= @empty_message %></p>
    </div>
  </div>
<% else %>
    <%
      brl = ->(value) { number_to_currency(value, unit: 'R$', separator: ',', delimiter: '.', precision: 2) }
      pct = ->(value) { "#{number_with_precision(value, precision: value.to_f < 10 ? 2 : 1, separator: ',')}%" }
      delta = lambda do |value, inverse: false|
        next '' if value.nil?
        good = inverse ? value.negative? : value.positive?
        variant = value.zero? ? 'neutral' : (good ? 'success' : 'danger')
        %(<span class="db-kpi__change crm-tag crm-tag--#{variant}">#{value.positive? ? '+' : ''}#{number_with_precision(value, precision: 1, separator: ',')}% vs período anterior</span>).html_safe
      end
      purchase = @funnel.last
      conversion_change = @prev_conversion_rate.positive? ? ((@conversion_rate - @prev_conversion_rate) / @prev_conversion_rate * 100).round(1) : nil
      worst = @funnel.drop(1).min_by { |step| step[:pct_step] }
      step_colors = %w[#3b82f6 #22c55e #f59e0b #8b5cf6 #ec4899]
    %>

    <div class="db-kpi-grid">
      <div class="db-kpi db-kpi--blue">
        <div class="db-kpi__label">Sessões</div>
        <div class="db-kpi__value"><%= number_with_delimiter(@unique_sessions, delimiter: '.') %></div>
        <%= delta.call(@funnel.first[:change]) %>
      </div>

      <div class="db-kpi db-kpi--green">
        <div class="db-kpi__label">Compraram</div>
        <div class="db-kpi__value"><%= number_with_delimiter(purchase[:count], delimiter: '.') %></div>
        <%= delta.call(purchase[:change]) %>
      </div>

      <div class="db-kpi db-kpi--amber">
        <div class="db-kpi__label">Taxa de conversão</div>
        <div class="db-kpi__value"><%= pct.call(@conversion_rate) %></div>
        <%= delta.call(conversion_change) %>
        <span class="db-kpi__hint">compras ÷ sessões</span>
      </div>

      <div class="db-kpi db-kpi--rose">
        <div class="db-kpi__label">Abandono de carrinho</div>
        <div class="db-kpi__value"><%= pct.call(@abandoned_rate) %></div>
        <span class="db-kpi__hint"><%= number_with_delimiter(@abandoned_carts, delimiter: '.') %> sessões puseram no carrinho e não compraram</span>
      </div>

      <div class="db-kpi db-kpi--purple">
        <div class="db-kpi__label">Receita por sessão</div>
        <div class="db-kpi__value"><%= brl.call(@orders_summary[:revenue_per_session]) %></div>
        <span class="db-kpi__hint"><%= number_with_delimiter(@orders_summary[:count], delimiter: '.') %> pedidos · <%= brl.call(@orders_summary[:revenue]) %> · ticket <%= brl.call(@orders_summary[:average_ticket]) %></span>
      </div>
    </div>

    <div class="db-funnel-section">
      <div class="db-funnel-section__header">
        <div class="db-funnel-section__title">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
          Funil de conversão por sessão
        </div>
        <div class="db-funnel-section__period">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <% period_label = { "1" => "Hoje", "7" => "Últimos 7 dias", "15" => "Últimos 15 dias", "30" => "Últimos 30 dias" }[@period] || "Hoje" %>
          <%= period_label %>
        </div>
      </div>

      <div class="db-funnel">
        <% @funnel.each_with_index do |step, index| %>
          <div class="db-funnel__step <%= 'db-funnel__step--worst' if step.equal?(worst) && step[:lost].positive? %>">
            <div class="db-funnel__count"><%= number_with_delimiter(step[:count], delimiter: '.') %></div>
            <div class="db-funnel__name"><%= step[:label] %></div>
            <div class="db-funnel__bar">
              <div class="db-funnel__bar-fill" style="width:<%= [step[:pct_total], 100].min %>%; background:<%= step_colors[index] %>"></div>
            </div>
            <div class="db-funnel__rate"><%= pct.call(step[:pct_total]) %> das sessões</div>
            <% if index.positive? %>
              <div class="db-funnel__step-rate"><%= pct.call(step[:pct_step]) %> da etapa anterior</div>
              <div class="db-funnel__dropoff">−<%= number_with_delimiter(step[:lost], delimiter: '.') %> sessões pararam aqui</div>
            <% end %>
            <% unless step[:change].nil? %>
              <div class="db-funnel__change db-funnel__change--<%= step[:change].negative? ? 'down' : 'up' %>">
                <%= step[:change].positive? ? '+' : '' %><%= number_with_precision(step[:change], precision: 1, separator: ',') %>% vs período anterior
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if worst && worst[:lost].positive? %>
        <p class="db-funnel__insight">
          Maior perda: <strong><%= worst[:label].downcase %></strong>. Só <%= pct.call(worst[:pct_step]) %>
          das sessões da etapa anterior chegaram aqui (<%= number_with_delimiter(worst[:lost], delimiter: '.') %> sessões).
          <% if @orders_summary[:count].positive? %>
            No mesmo período a Shopify registrou <%= number_with_delimiter(@orders_summary[:count], delimiter: '.') %> pedidos
            (<%= brl.call(@orders_summary[:revenue]) %>), incluindo canais fora do site.
          <% end %>
        </p>
      <% end %>
    </div>


    <div class="db-grid-2">
      <div class="db-card">
        <div class="db-card__header">
          <span class="db-card__title">Eventos por Dia</span>
        </div>
        <div class="db-chart-wrap">
          <div id="events_chart"></div>
        </div>
      </div>

      <div class="db-card">
        <div class="db-card__header">
          <span class="db-card__title">Dispositivos</span>
        </div>
        <div class="db-chart-wrap">
          <div id="devices_chart"></div>
        </div>
      </div>
    </div>


    <div class="db-grid-3">
      <div class="db-card">
        <div class="db-card__header">
          <span class="db-card__title">Origem do Trafego</span>
        </div>
        <div class="db-chart-wrap">
          <div id="referrers_chart"></div>
        </div>
      </div>

      <div class="db-card">
        <div class="db-card__header">
          <span class="db-card__title">Top Produtos Vistos</span>
        </div>
        <% if @top_products_viewed.any? %>
          <ul class="db-top-list db-top-list--products">
            <% @top_products_viewed.each_with_index do |p, i| %>
              <li>
                <span class="db-top-list__rank"><%= i + 1 %></span>
                <% if p[:image].present? %>
                  <img
                    src="<%= p[:image].start_with?('//') ? "https:#{p[:image]}" : p[:image] %>"
                    alt="<%= p[:title] %>"
                    class="db-top-list__img"
                    loading="lazy"
                  />
                <% else %>
                  <span class="db-top-list__img-placeholder">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                  </span>
                <% end %>
                <div class="db-top-list__info">
                  <span class="db-top-list__title"><%= p[:title] %></span>
                  <% if p[:sku].present? %>
                    <span class="db-top-list__sku">SKU: <%= p[:sku] %></span>
                  <% elsif p[:price].present? && p[:price].to_f > 0 %>
                    <span class="db-top-list__price">
                      <%= number_to_currency(p[:price], unit: "R$", separator: ",", delimiter: ".") %>
                    </span>
                  <% end %>
                </div>
                <span class="db-top-list__count"><%= p[:count] %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="db-empty-note">Sem dados</p>
        <% end %>
      </div>

      <div class="db-card">
        <div class="db-card__header">
          <span class="db-card__title">Top Produtos no Carrinho</span>
        </div>
        <% if @top_products_carted.any? %>
          <ul class="db-top-list db-top-list--products">
            <% @top_products_carted.each_with_index do |p, i| %>
              <li>
                <span class="db-top-list__rank"><%= i + 1 %></span>
                <% if p[:image].present? %>
                  <img
                    src="<%= p[:image].start_with?('//') ? "https:#{p[:image]}" : p[:image] %>"
                    alt="<%= p[:title] %>"
                    class="db-top-list__img"
                    loading="lazy"
                  />
                <% else %>
                  <span class="db-top-list__img-placeholder">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13l-1.35 2.7A1 1 0 007 17h11M7 13l-.4-2M17 17a2 2 0 100 4 2 2 0 000-4zm-8 0a2 2 0 100 4 2 2 0 000-4z"/></svg>
                  </span>
                <% end %>
                <div class="db-top-list__info">
                  <span class="db-top-list__title"><%= p[:title] %></span>
                  <% if p[:sku].present? %>
                    <span class="db-top-list__sku">SKU: <%= p[:sku] %></span>
                  <% elsif p[:price].present? && p[:price].to_f > 0 %>
                    <span class="db-top-list__price">
                      <%= number_to_currency(p[:price], unit: "R$", separator: ",", delimiter: ".") %>
                    </span>
                  <% end %>
                </div>
                <span class="db-top-list__count"><%= p[:count] %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="db-empty-note">Sem dados</p>
        <% end %>
      </div>
    </div>


    <div class="db-card" style="margin-bottom:24px">
      <div class="db-card__header">
        <span class="db-card__title">Atividade por Hora do Dia</span>
      </div>
      <% max_hour = @hourly_events.values.max || 1 %>
      <div class="db-heatmap">
        <% @hourly_events.each do |hour, count| %>
          <%
            intensity = count.to_f / max_hour
            bg = if intensity == 0
              '#f1f5f9'
            elsif intensity < 0.25
              '#dbeafe'
            elsif intensity < 0.5
              '#93c5fd'
            elsif intensity < 0.75
              '#3b82f6'
            else
              '#1d4ed8'
            end
            text_color = intensity >= 0.5 ? '#fff' : '#64748b'
          %>
          <div
            class="db-heatmap__cell"
            style="background:<%= bg %>; color:<%= text_color %>"
            data-tooltip="<%= hour %>h: <%= count %> eventos"
          >
            <%= count > 0 ? count : '' %>
          </div>
        <% end %>
      </div>
      <div class="db-heatmap__labels">
        <% (0..23).each do |h| %>
          <span class="db-heatmap__label"><%= h.to_s.rjust(2, '0') %></span>
        <% end %>
      </div>
    </div>


    <div class="db-grid-2">
      <div class="db-card">
        <div class="db-card__header">
          <span class="db-card__title">Atividade por Dia da Semana</span>
        </div>
        <div class="db-chart-wrap">
          <div id="weekday_chart"></div>
        </div>
      </div>

      <div class="db-card">
        <div class="db-card__header">
          <span class="db-card__title">Funil Comparativo</span>
        </div>
        <div class="db-chart-wrap">
          <div id="funnel_bar_chart"></div>
        </div>
      </div>
    </div>


    <div class="db-table-card">
      <div class="db-table-card__header">
        <span class="db-table-card__title">Sessoes Recentes</span>
        <span class="db-table-card__count"><%= @sessions.size %> sessoes | <%= @sessions.count { |s| !s[:abandoned] } %> convertidas</span>
      </div>

      <div class="db-table-wrap">
        <table class="db-table crm-table">
          <thead>
            <tr>
              <th>Sessao</th>
              <th>Dominio</th>
              <th>Jornada</th>
              <th class="center">Device</th>
              <th class="center">Duracao</th>
              <th class="center">Eventos</th>
              <th class="center">Status</th>
            </tr>
          </thead>

          <tbody>
            <% if @sessions.empty? %>
              <tr>
                <td colspan="7" class="db-table__empty">
                  Nenhuma sessao encontrada no periodo selecionado.
                </td>
              </tr>
            <% else %>
              <% @sessions.each do |s| %>
                <tr
                  class="db-session-row <%= 'db-table__row--abandoned' if s[:abandoned] %>"
                  data-session-id="<%= s[:session_id] %>"
                  data-fetch-url="<%= crm_session_path(session_id: s[:session_id]) %>"
                >
                  <td>
                    <span class="db-badge db-badge--mono"><%= s[:session_id].truncate(12) %></span>
                  </td>
                  <td style="font-weight:500; color:#0f172a"><%= s[:shop_domain] %></td>
                  <td>
                    <div style="display:flex; gap:4px; flex-wrap:wrap">
                      <% s[:last_kinds].each do |kind| %>
                        <%
                          badge_class = case kind
                            when 'page_viewed'           then 'db-badge--info'
                            when 'product_viewed'        then 'crm-tag crm-tag--success'
                            when 'product_added_to_cart' then 'crm-tag crm-tag--warning'
                            when 'checkout_started'      then 'crm-tag crm-tag--warning'
                            when 'checkout_completed'    then 'db-badge--checkout'
                            else ''
                          end
                        %>
                        <span class="db-badge <%= badge_class %>"><%= kind.split('_').first(2).join(' ') %></span>
                      <% end %>
                    </div>
                  </td>
                  <td class="center">
                    <span class="db-badge db-badge--device"><%= s[:device] %></span>
                  </td>
                  <td class="center" style="color:#64748b; font-size:12px"><%= s[:duration_min] %> min</td>
                  <td class="center">
                    <span class="db-badge db-badge--count"><%= s[:event_count] %></span>
                  </td>
                  <td class="center">
                    <% if s[:abandoned] %>
                      <span class="crm-tag crm-tag--danger">nao converteu</span>
                    <% else %>
                      <span class="crm-tag crm-tag--success">converteu</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>


  <%# Dados dos gráficos: o script da página lê isto e desenha (scripts
      inseridos via innerHTML não rodam). %>
  <script type="application/json" id="db-chart-data"><%= raw({
    daily: %w[page_viewed product_viewed product_added_to_cart checkout_completed].index_with { |kind|
      @daily_events.select { |k, _| k[1] == kind }.map { |k, v| [k[0], v] }
    },
    devices: [@devices[:desktop], @devices[:mobile], @devices[:tablet]],
    referrers: { labels: @referrers.keys, values: @referrers.values },
    weekday: { labels: @weekday_events.map { |d| d[:day] }, values: @weekday_events.map { |d| d[:count] } },
    funnel: @funnel.map { |step| step[:count] }
  }.to_json.gsub('</', '<\\/')) %></script>
<% end %>
