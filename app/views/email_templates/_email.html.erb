<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <title><%= message.subject %></title>
  <style>
    @media (max-width: 600px) {
      .email-container { width: 100% !important; }
      .email-column { display: block !important; width: 100% !important; box-sizing: border-box !important; }
      .email-side-image { height: auto !important; max-height: 320px !important; }
      .email-pad { padding-left: 20px !important; padding-right: 20px !important; }
    }
    <% if message.preview? %>
      [data-block-id] { cursor: pointer; outline: 2px solid transparent; outline-offset: -2px; transition: outline-color .12s ease; }
      [data-block-id]:hover { outline-color: rgba(124, 58, 237, .45); }
      [data-block-id].is-selected { outline-color: #7c3aed; }
      .email-placeholder { display: block; padding: 36px 12px; background: repeating-linear-gradient(45deg, #f1effa, #f1effa 10px, #ebe7f8 10px, #ebe7f8 20px); color: #8b7fb8; font: 600 13px Arial, sans-serif; text-align: center; border-radius: 6px; }
    <% end %>
  </style>
</head>
<body style="margin: 0; padding: 0; background: <%= message.design['bg'] %>;">
  <% if message.preheader.present? %>
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent;"><%= message.preheader %>&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div>
  <% end %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: <%= message.design['bg'] %>;">
    <tr>
      <td align="center" style="padding: 24px 12px;">
        <table role="presentation" class="email-container" width="600" cellpadding="0" cellspacing="0" border="0"
               style="width: 600px; max-width: 600px; background: <%= message.design['content_bg'] %>; border-radius: <%= message.radius %>px; overflow: hidden; font-family: <%= message.font_family %>; color: <%= message.design['text_color'] %>;">
          <% message.blocks.each do |block| %>
            <tr>
              <td class="<%= 'email-pad' unless block['pad'] == 'none' %>"
                  style="padding: <%= message.padding(block) %>;<%= " background: #{block['bg']};" if block['bg'].present? %>"
                  <% if message.preview? %>data-block-id="<%= block['id'] %>"<% end %>>
                <%= render "email_templates/blocks/#{block['type']}", block: block, message: message %>
              </td>
            </tr>
          <% end %>
        </table>

        <table role="presentation" class="email-container" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 600px; max-width: 600px;">
          <tr>
            <td align="center" style="padding: 20px 24px; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 1.6; color: #888888;">
              <% if message.store_name.present? %>Enviado por <%= message.store_name %>.<% end %>
              <% if message.unsubscribe_url %>
                <br><a href="<%= message.unsubscribe_url %>" target="_blank" style="color: #888888;">Não quero mais receber estes e-mails</a>
              <% end %>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
