<%= form_for email_template, as: :email_template,
             url: (email_template.persisted? ? email_template_path(email_template) : email_templates_path),
             method: (email_template.persisted? ? :patch : :post),
             html: { autocomplete: 'off', id: 'email-template-form', class: 'eb-form' } do |form| %>
  <%= hidden_field_tag 'email_template[blocks_json]', '', id: 'email-field-blocks' %>
  <%= hidden_field_tag 'email_template[design_json]', '', id: 'email-field-design' %>
  <script type="application/json" id="email-builder-state"><%= raw json_escape(editor_state(email_template).to_json) %></script>

  <% if email_template.errors.any? %>
    <div class="users-form-page__errors eb-errors">
      <div class="users-form-page__errors-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
      <div>
        <strong>Corrija os erros abaixo:</strong>
        <ul>
          <% email_template.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="eb-topbar crm-card">
    <div class="eb-topbar__fields">
      <div class="eb-topbar__field">
        <%= form.label :name, 'Nome interno', class: 'crm-label' %>
        <%= form.text_field :name, class: 'crm-input', placeholder: 'Ex.: Carrinho abandonado — padrão' %>
      </div>
      <div class="eb-topbar__field eb-topbar__field--wide">
        <%= form.label :subject, 'Assunto', class: 'crm-label' %>
        <div class="eb-input-with-vars">
          <%= form.text_field :subject, class: 'crm-input', id: 'email-field-subject', placeholder: 'O que aparece na caixa de entrada' %>
        </div>
      </div>
    </div>
    <div class="eb-topbar__actions">
      <div class="eb-history" role="group" aria-label="Histórico">
        <button type="button" class="crm-btn clients-btn--icon" id="eb-undo" title="Desfazer (Ctrl+Z)" disabled><i class="fa-solid fa-rotate-left"></i></button>
        <button type="button" class="crm-btn clients-btn--icon" id="eb-redo" title="Refazer (Ctrl+Shift+Z)" disabled><i class="fa-solid fa-rotate-right"></i></button>
      </div>
      <label class="eb-active-toggle" title="Só e-mails ativos são disparados">
        <%= form.check_box :active, class: 'cform-toggle__input' %>
        <span>Ativo</span>
      </label>
      <%= form.button class: 'crm-btn crm-btn--primary', data: { disable_with: 'Salvando...' } do %>
        <i class="fa-solid fa-floppy-disk"></i> Salvar e-mail
      <% end %>
    </div>
  </div>

  <div class="eb" id="email-builder">
    <aside class="eb-panel crm-card">
      <nav class="eb-tabs" role="tablist">
        <button type="button" class="eb-tabs__tab active" data-tab="content"><i class="fa-solid fa-layer-group"></i> Conteúdo</button>
        <button type="button" class="eb-tabs__tab" data-tab="style"><i class="fa-solid fa-palette"></i> Estilo</button>
        <button type="button" class="eb-tabs__tab" data-tab="settings"><i class="fa-solid fa-sliders"></i> Envio</button>
      </nav>

      <%# Conteúdo: paleta de blocos + estrutura (gerados pelo email_templates.js) %>
      <section class="eb-pane active" data-pane="content">
        <div class="eb-section-title">Arraste ou clique para adicionar</div>
        <div class="eb-palette" id="eb-palette"></div>

        <div class="eb-section-title">Seções prontas</div>
        <div class="eb-sections" id="eb-sections"></div>

        <div class="eb-section-title eb-section-title--row">
          <span>Estrutura do e-mail</span>
          <span class="eb-muted" id="eb-count"></span>
        </div>
        <ol class="eb-layers" id="eb-layers"></ol>
        <div class="eb-footer-lock">
          <i class="fa-solid fa-lock"></i>
          Rodapé com <strong>"Não quero mais receber estes e-mails"</strong> — sempre incluído
        </div>
      </section>

      <%# Inspector do bloco selecionado %>
      <section class="eb-pane eb-inspector" data-pane="inspector">
        <div class="eb-inspector__header">
          <button type="button" class="eb-link-btn" id="eb-inspector-back"><i class="fa-solid fa-arrow-left"></i> Blocos</button>
          <div class="eb-inspector__actions">
            <button type="button" class="crm-btn clients-btn--icon" data-action="up" title="Subir (Alt+↑)"><i class="fa-solid fa-arrow-up"></i></button>
            <button type="button" class="crm-btn clients-btn--icon" data-action="down" title="Descer (Alt+↓)"><i class="fa-solid fa-arrow-down"></i></button>
            <button type="button" class="crm-btn clients-btn--icon" data-action="duplicate" title="Duplicar (Ctrl+D)"><i class="fa-solid fa-copy"></i></button>
            <button type="button" class="crm-btn clients-btn--icon clients-btn--danger" data-action="remove" title="Excluir (Delete)"><i class="fa-solid fa-trash-can"></i></button>
          </div>
        </div>
        <div class="eb-inspector__title" id="eb-inspector-title"></div>
        <div class="eb-inspector__body" id="eb-inspector-body"></div>
      </section>

      <%# Estilo global (campos gerados pelo JS) + cor de destaque (coluna própria) %>
      <section class="eb-pane" data-pane="style">
        <div class="eb-field">
          <%= form.label :accent_color, 'Cor da marca (botões, cupons e links)', class: 'crm-label' %>
          <div class="eb-color">
            <%= form.color_field :accent_color, class: 'eb-color__swatch', id: 'email-field-color' %>
            <span class="eb-color__value" data-color-value-for="email-field-color"></span>
          </div>
        </div>
        <div id="eb-design"></div>
      </section>

      <section class="eb-pane" data-pane="settings">
        <div class="eb-field">
          <%= form.label :trigger_kind, 'Quando enviar', class: 'crm-label' %>
          <%= form.select :trigger_kind,
              options_for_select(EmailTemplate::TRIGGER_LABELS.invert, form.object.trigger_kind),
              {}, class: 'crm-input', id: 'email-field-trigger' %>
          <span class="cpform-field__hint" id="email-trigger-pending-hint">O disparo automático será configurado numa próxima etapa — por enquanto isso só marca a finalidade do e-mail.</span>
        </div>

        <div class="eb-field email-templates-trigger-config" data-trigger="cart_recovery">
          <%= form.label :trigger_delay_hours, 'Enviar quantas horas após o carrinho ser abandonado', class: 'crm-label' %>
          <%= form.text_field :trigger_delay_hours, class: 'crm-input', value: email_template.trigger_delay_hours %>
        </div>

        <div class="eb-field email-templates-trigger-config" data-trigger="inactive_customer">
          <%= form.label :trigger_inactive_days, 'Enviar após quantos dias sem comprar', class: 'crm-label' %>
          <%= form.text_field :trigger_inactive_days, class: 'crm-input', value: email_template.trigger_inactive_days %>
        </div>

        <div class="eb-field email-templates-trigger-config" data-trigger="post_purchase">
          <%= form.label :trigger_days_after_purchase, 'Enviar quantos dias após a compra', class: 'crm-label' %>
          <%= form.text_field :trigger_days_after_purchase, class: 'crm-input', value: email_template.trigger_days_after_purchase %>
        </div>

        <div class="eb-field email-templates-trigger-config" data-trigger="back_in_stock">
          <span class="cpform-field__hint">
            Enviado quando o produto que o cliente pediu volta ao estoque. Use o bloco <strong>Produto</strong> para mostrar
            foto, nome e variação; botões sem link próprio levam para a página do produto.
          </span>
        </div>

        <div class="eb-tip">
          <i class="fa-solid fa-shield-heart"></i>
          <div>
            Quem estiver na <%= link_to 'lista de recusa', email_suppressions_path %> nunca recebe este e-mail,
            mesmo com o gatilho ativo.
          </div>
        </div>
      </section>
    </aside>

    <section class="eb-stage crm-card">
      <div class="eb-stage__toolbar">
        <div class="eb-device" role="group" aria-label="Dispositivo">
          <button type="button" class="eb-device__btn active" data-device="desktop" title="Computador"><i class="fa-solid fa-desktop"></i></button>
          <button type="button" class="eb-device__btn" data-device="mobile" title="Celular"><i class="fa-solid fa-mobile-screen"></i></button>
        </div>
        <span class="eb-muted eb-stage__hint"><i class="fa-solid fa-hand-pointer"></i> Clique em qualquer parte do e-mail para editar</span>
        <span class="eb-stage__status" id="eb-status"></span>
      </div>

      <div class="eb-inbox" id="email-preview" data-url="<%= preview_email_templates_path(id: email_template.id) %>"
           data-upload-url="<%= upload_image_email_templates_path %>">
        <div class="eb-inbox__avatar"><%= current_client.name.to_s.first.upcase %></div>
        <div class="eb-inbox__lines">
          <div class="eb-inbox__from"><%= current_client.name %> <span class="eb-muted">· agora</span></div>
          <div class="eb-inbox__subject" id="email-preview-subject"></div>
          <div class="eb-inbox__preheader eb-muted" id="email-preview-preheader"></div>
        </div>
      </div>

      <div class="eb-stage__viewport" id="eb-viewport">
        <div class="eb-stage__device" id="eb-device-frame">
          <iframe class="eb-stage__frame" id="email-preview-frame" title="Preview do e-mail" sandbox="allow-same-origin"></iframe>
        </div>
      </div>
    </section>
  </div>
<% end %>

<%= javascript_include_tag 'email_templates', defer: true %>
