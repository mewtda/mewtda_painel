<% src = message.image_url(block['image_id']) %>
<% href = message.link(block['link']) %>
<% image_cell = capture do %>
  <td class="email-column" width="45%" valign="top" style="padding: 0;">
    <% if src %>
      <img src="<%= src %>" alt="" width="250" class="email-side-image"
           style="display: block; width: 100%; height: 100%; min-height: 220px; object-fit: cover; border: 0; border-radius: 8px;">
    <% elsif message.preview? %>
      <span class="email-placeholder" style="min-height: 150px;">🖼️ Imagem</span>
    <% end %>
  </td>
<% end %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <%= image_cell if block['side'] == 'left' && (src || message.preview?) %>
    <td class="email-column" valign="middle" style="padding: 8px <%= block['side'] == 'right' ? '20px 8px 0' : '0 8px 20px' %>;">
      <% if block['heading'].present? %>
        <h2 style="margin: 0 0 10px; font-size: 22px; line-height: 1.3; color: <%= message.design['text_color'] %>; font-family: <%= message.font_family %>;"><%= message.interpolate(block['heading']) %></h2>
      <% end %>
      <div style="margin: 0 0 18px; font-size: 15px; line-height: 1.6; color: <%= message.design['text_color'] %>;"><%= message.rich_text(block['text']) %></div>
      <% if block['button_text'].present? && href %>
        <table role="presentation" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td style="border-radius: <%= message.button_radius %>px; background: <%= message.color(block['color']) %>;">
              <a href="<%= href %>" target="_blank" style="display: inline-block; padding: 12px 26px; font-size: 14px; font-weight: bold; color: #ffffff; text-decoration: none;">
                <%= message.interpolate(block['button_text']) %>
              </a>
            </td>
          </tr>
        </table>
      <% end %>
    </td>
    <%= image_cell if block['side'] == 'right' && (src || message.preview?) %>
  </tr>
</table>
