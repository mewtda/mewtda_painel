<% title 'Novo e-mail' %>

<div class="email-templates-gallery">
  <p class="email-templates-gallery__label">Comece de um modelo pronto ou do zero — depois é só arrastar, trocar e reorganizar os blocos:</p>
  <div class="email-templates-gallery__grid">
    <% gallery = { nil => { name: 'Em branco', blocks: EmailTemplate::BLANK[:blocks] } }.merge(EmailTemplate::PRESETS) %>
    <% gallery.each do |key, preset| %>
      <% active = key.nil? ? params[:preset].blank? : params[:preset] == key.to_s %>
      <%= link_to new_email_template_path(preset: key), class: "email-templates-gallery__card #{'active' if active}" do %>
        <span class="eb-thumb" aria-hidden="true">
          <% preset[:blocks].each do |block| %>
            <span class="eb-thumb__block eb-thumb__block--<%= block['type'] %>"></span>
          <% end %>
        </span>
        <span class="email-templates-gallery__card-name"><%= preset[:name] %></span>
      <% end %>
    <% end %>
  </div>
</div>

<div class="eb-page">
  <%= render 'form', email_template: @email_template %>
</div>
