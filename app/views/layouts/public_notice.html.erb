<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title><%= content_for?(:title) ? yield(:title) : 'Mewtda' %></title>
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag 'public_notice', media: 'all' %>
  </head>
  <body class="notice">
    <main class="notice__card">
      <%= yield %>
    </main>
  </body>
</html>
