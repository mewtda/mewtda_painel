<% title 'Pedidos' %>

<div class="pa-page">
  <div class="ss-header">
    <div>
      <div class="ss-header__crumb"><%= @client&.name %></div>
      <h1 class="ss-header__title">Pedidos</h1>
    </div>
  </div>

  <%= render 'shared/page_tabs', current: @tab,
             tabs: [['dashboard', 'Dashboard', 'fa-chart-line'], ['pedidos', 'Pedidos', 'fa-receipt']],
             path: ->(key) { orders_path(aba: key) } %>

  <% if @tab == 'dashboard' %>
    <%= render 'dashboard', dashboard: @dashboard %>
  <% else %>
    <%= render 'list' %>
  <% end %>
</div>
