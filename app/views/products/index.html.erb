<% title 'Produtos' %>

<div class="pa-page">
  <div class="ss-header">
    <div>
      <div class="ss-header__crumb"><%= @client&.name %></div>
      <h1 class="ss-header__title">Produtos</h1>
    </div>
  </div>

  <%= render 'shared/page_tabs', current: @tab,
             tabs: [['dashboard', 'Dashboard', 'fa-chart-pie'], ['produtos', 'Produtos', 'fa-box']],
             path: ->(key) { products_path(aba: key) } %>

  <% if @tab == 'dashboard' %>
    <%= render 'dashboard', abc: @abc %>
  <% else %>
    <%= render 'list' %>
  <% end %>
</div>
