<%= form_with model: template, scope: :whatsapp_template,
              url: (template.persisted? ? whatsapp_template_path(template) : whatsapp_templates_path),
              method: (template.persisted? ? :patch : :post), id: 'wt-form', class: 'wt-form' do |form| %>
  <div class="sg-topbar">
    <div class="sg-topbar__left">
      <%= link_to whatsapp_templates_path, class: 'sg-back' do %><i class="fa-solid fa-arrow-left"></i> Modelos de WhatsApp<% end %>
    </div>
    <%= form.button class: 'crm-btn crm-btn--primary' do %><i class="fa-solid fa-floppy-disk"></i> Salvar rascunho<% end %>
  </div>

  <% if template.errors.any? %>
    <div class="users-form-page__errors">
      <div class="users-form-page__errors-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
      <ul><% template.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <% if template.status == 'rejected' && template.rejection_reason.present? %>
    <div class="crm-card wt-notice wt-notice--danger">
      <i class="fa-solid fa-circle-xmark"></i>
      <div><strong>A Meta rejeitou este modelo.</strong> <span class="cx-muted">Motivo: <%= template.rejection_reason %>. Ajuste o texto e envie de novo.</span></div>
    </div>
  <% end %>

  <div class="wt-layout">
    <div class="crm-card wt-fields">
      <div class="wt-field">
        <%= form.label :label, 'Nome do modelo', class: 'crm-label' %>
        <%= form.text_field :label, class: 'crm-input', maxlength: 120, placeholder: 'Ex.: Black Friday — aviso 1', required: true %>
        <small class="cx-muted">Só para você encontrar depois. Na Meta ele vira <code><%= template.name.presence || 'black_friday_aviso_1' %></code>.</small>
      </div>

      <div class="wt-field">
        <%= form.label :body, 'Mensagem', class: 'crm-label' %>
        <%= form.text_area :body, class: 'crm-input wt-body', rows: 7, maxlength: 1024, data: { wt_body: true },
                           placeholder: "Oi {{1}}! A Black Friday da loja começou: até 50% off em toda a coleção. 🖤" %>
        <div class="wt-body-actions">
          <button type="button" class="crm-btn crm-btn--secondary wt-insert" data-wt-insert>
            <i class="fa-solid fa-user"></i> Inserir primeiro nome do cliente
          </button>
          <small class="cx-muted"><span data-wt-count>0</span>/1024 · use *negrito* e _itálico_ como no WhatsApp</small>
        </div>
      </div>

      <div class="wt-field" data-wt-example>
        <%= form.label :body_example, 'Exemplo de nome (pedido pela Meta)', class: 'crm-label' %>
        <%= form.text_field :body_example, class: 'crm-input', placeholder: 'Maria', maxlength: 60 %>
        <small class="cx-muted">Quem não tiver nome no cadastro recebe "cliente" no lugar.</small>
      </div>

      <div class="wt-field">
        <%= form.label :footer, 'Rodapé (opcional)', class: 'crm-label' %>
        <%= form.text_field :footer, class: 'crm-input', maxlength: 60, placeholder: 'Responda SAIR para não receber mais' %>
      </div>

      <div class="wt-field wt-field--row">
        <div>
          <%= form.label :button_text, 'Botão de link (opcional)', class: 'crm-label' %>
          <%= form.text_field :button_text, class: 'crm-input', maxlength: 25, placeholder: 'Ver ofertas' %>
        </div>
        <div>
          <%= form.label :button_url, 'Endereço do botão', class: 'crm-label' %>
          <%= form.url_field :button_url, class: 'crm-input', placeholder: 'https://sualoja.com.br/black' %>
        </div>
      </div>

      <p class="cx-muted wt-hint">
        <i class="fa-solid fa-circle-info"></i>
        Categoria Marketing, em português. Depois de salvar, use <strong>Enviar para aprovação</strong> na lista.
        A Meta costuma responder de minutos a algumas horas; o status aqui é atualizado sozinho.
      </p>
    </div>

    <div class="wt-preview">
      <span class="crm-label">Prévia</span>
      <%= render 'whatsapp_templates/bubble', template: template %>
    </div>
  </div>
<% end %>

<%= javascript_include_tag 'whatsapp_templates', defer: true %>
