<% content_for :title, 'Cancelar inscrição' %>

<p class="notice__store"><%= @alert.client.name %></p>
<h1 class="notice__title">Não quer mais receber nossos e-mails?</h1>
<p class="notice__text">
  Ao confirmar, <strong><%= @alert.email %></strong> entra na nossa lista de recusa e não recebe mais nenhum e-mail da <%= @alert.client.name %>
  — inclusive o aviso de <strong><%= @alert.product_title %></strong><%= " (#{@alert.variant_title})" if @alert.variant_title.present? %>.
</p>
<%= button_to 'Confirmar descadastro', widget_back_in_stock_unsubscribe_path(token: params[:token]), class: 'notice__button' %>
